---
/**
 * Brand mark: the official Glazebrooke logo (brand.logo), in forest green on
 * light surfaces and white on dark ones. Falls back to a typographic wordmark
 * when brand.logo is null.
 */
import { brand } from '../config/brand.config';

interface Props {
  /** Fallback wordmark subtitle, e.g. 'Coffee Estate'. */
  descriptor?: string;
  /** Small label beside the logo, e.g. 'Shop'. */
  suffix?: string;
  /** Surface the mark sits on. */
  tone?: 'light' | 'dark';
  class?: string;
}
const { descriptor = 'Coffee Estate', suffix, tone = 'light', class: className } = Astro.props;
const logo = brand.logo;
---

{
  logo ? (
    <span class:list={['logo', className]}>
      <img
        class="logo__img"
        src={tone === 'dark' ? logo.onDark : logo.onLight}
        alt=""
        width={logo.width}
        height={logo.height}
        decoding="async"
      />
      {suffix && (
        <span class="logo__suffix" aria-hidden="true">
          {suffix}
        </span>
      )}
    </span>
  ) : (
    <span class:list={['wordmark', className]} aria-hidden="true">
      <span class="wordmark__name">Glazebrooke</span>
      <span class="wordmark__sub">{descriptor}</span>
    </span>
  )
}

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: currentColor;
  }
  .logo__img {
    height: 1.9rem;
    width: auto;
  }
  @media (min-width: 64rem) {
    .logo__img {
      height: 2.1rem;
    }
  }
  .logo__suffix {
    padding-left: 0.75rem;
    border-left: 1px solid currentColor;
    font-family: var(--f-text);
    font-size: 0.8125rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    line-height: 1.4;
  }
  .wordmark {
    display: inline-flex;
    flex-direction: column;
    line-height: 1;
    color: currentColor;
  }
  .wordmark__name {
    font-family: var(--f-display);
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  .wordmark__sub {
    margin-top: 0.3rem;
    font-family: var(--f-text);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    opacity: 0.8;
  }
</style>
