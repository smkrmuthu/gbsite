---
import MainLayout from '../layouts/MainLayout.astro';
import BuyCoffee from '../components/BuyCoffee.astro';
import Photo from '@glazebrooke/brand/components/Photo.astro';
import ElevationDiagram from '@glazebrooke/brand/components/ElevationDiagram.astro';
import { fact, elevationRange } from '@glazebrooke/brand/config/facts';

const established = fact('established');
const years = fact('heritageYears');
const family = fact('familyOwned');
const elevation = elevationRange();

const statement =
  (established ? `Established in the ${established}, ` : '') +
  `Glazebrooke is ${family ? 'a family-owned' : 'a'} coffee estate in the Shevaroy Hills of Tamil Nadu` +
  (years ? `, with more than ${years} years of coffee heritage.` : '.');

const heroIntro = established
  ? `Discover the story of Glazebrooke Coffee Estate, where coffee has grown on the slopes of Yercaud since the ${established}.`
  : 'Discover the story of Glazebrooke Coffee Estate and the coffee grown on the slopes of Yercaud.';

const paths = [
  {
    href: '/our-coffee/',
    photo: 'coffee-cherries',
    tone: 'espresso',
    title: 'Estate-grown coffee from Yercaud',
    text: 'Coffee grown on our own slopes in the Shevaroy Hills. Learn about the coffee, then order it from the Glazebrooke shop.',
    link: 'Explore our coffee',
  },
  {
    href: '/sustainability/',
    photo: 'estate-nature',
    tone: 'olive',
    title: 'Growing coffee. Preserving nature.',
    text: 'Coffee on a hillside depends on the health of the land around it: the soil, the water, the trees and the wildlife.',
    link: 'Our approach to sustainability',
  },
  {
    href: '/our-people/',
    photo: 'people-harvest',
    tone: 'beige',
    title: 'The people behind the estate',
    text: 'Every harvest at Glazebrooke depends on the people who look after the estate through the year.',
    link: 'Meet our people',
  },
] as const;
---

<MainLayout
  title="Glazebrooke Coffee Estate | Estate-Grown Coffee from Yercaud, Tamil Nadu"
  description="Glazebrooke is a family-owned coffee estate in Yercaud, in the Shevaroy Hills of Tamil Nadu. Discover our story, our estate and our coffee."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__head">
      <h1 id="hero-title" class="hero__title">
        <span class="reveal-line" style="--i:0">Beyond coffee.</span>
        <span class="reveal-line hero__indent" style="--i:1">A legacy rooted in nature.</span>
      </h1>
      <div class="hero__aside reveal-soft">
        <p>{heroIntro}</p>
        <div class="actions">
          <a class="btn" href="/beyond-coffee/">Discover our story</a>
          <a class="text-link" href="/our-coffee/">Explore our coffee</a>
        </div>
      </div>
    </div>
    <Photo
      slot="estate-hero"
      priority
      ratio="var(--hero-ratio)"
      sizes="100vw"
      widths={[640, 960, 1280, 1920, 2560]}
      class="hero__photo"
    />
  </section>

  <section class="section statement" aria-labelledby="statement-title">
    <div class="container grid">
      <h2 id="statement-title" class="kicker statement__label">Our story</h2>
      <div class="statement__body">
        <p class="lede">{statement}</p>
        <a class="text-link" href="/beyond-coffee/">Read our story</a>
      </div>
    </div>
  </section>

  {
    elevation && (
      <section class="section surface-forest on-dark elevation-band" aria-labelledby="estate-title">
        <div class="container grid">
          <div class="elevation-band__text">
            <h2 id="estate-title">Where nature shapes every bean.</h2>
            <p>
              Our coffee grows on the hillsides around Yercaud, at approximately {elevation.feet} above sea level, in the cooler air of the
              Shevaroy Hills.
            </p>
            <a class="text-link" href="/our-estate/">Explore the estate</a>
          </div>
          <div class="elevation-band__figure">
            <ElevationDiagram tone="dark" />
          </div>
        </div>
      </section>
    )
  }

  <section class="section paths" aria-label="More about Glazebrooke">
    <div class="container">
      {
        paths.map((p, i) => (
          <article class:list={['path', { 'path--flip': i % 2 === 1 }]}>
            <a href={p.href} class="path__media" tabindex="-1" aria-hidden="true">
              <Photo slot={p.photo} tone={p.tone} ratio="5 / 4" sizes="(min-width: 64rem) 50vw, 100vw" />
            </a>
            <div class="path__text">
              <h2 class="t-2xl">{p.title}</h2>
              <p>{p.text}</p>
              <a class="text-link" href={p.href}>
                {p.link}
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <BuyCoffee />
</MainLayout>

<style>
  .hero {
    --hero-ratio: 4 / 5;
    padding-top: var(--s-8);
  }
  @media (min-width: 40rem) {
    .hero {
      --hero-ratio: 3 / 2;
    }
  }
  @media (min-width: 64rem) {
    .hero {
      --hero-ratio: 21 / 9;
      padding-top: var(--s-9);
    }
  }
  .hero__head {
    display: grid;
    gap: var(--s-7);
    padding-bottom: var(--s-8);
  }
  .hero__title {
    font-size: var(--t-4xl);
  }
  .hero__aside {
    display: grid;
    gap: var(--s-6);
    max-width: 30rem;
    font-size: var(--t-lg);
  }
  @media (min-width: 48rem) {
    .hero__indent {
      padding-left: 1.2em;
    }
  }
  @media (min-width: 72rem) {
    .hero__head {
      grid-template-columns: 8fr 4fr;
      align-items: end;
    }
    .hero__aside {
      padding-bottom: 0.6rem;
    }
  }

  .statement__label {
    margin: 0;
  }
  @media (min-width: 64rem) {
    .statement__label {
      grid-column: 1 / span 3;
      padding-top: 0.9rem;
    }
    .statement__body {
      grid-column: 4 / span 8;
    }
  }
  .statement__body {
    display: grid;
    gap: var(--s-6);
    justify-items: start;
  }
  .statement .lede {
    font-size: var(--t-3xl);
    line-height: 1.12;
    max-width: 18em;
  }

  .elevation-band__text {
    display: grid;
    gap: var(--s-5);
    align-content: start;
    justify-items: start;
  }
  .elevation-band__text p {
    max-width: 28rem;
    color: var(--c-beige);
  }
  @media (min-width: 64rem) {
    .elevation-band__text {
      grid-column: 1 / span 5;
    }
    .elevation-band__figure {
      grid-column: 6 / -1;
    }
  }

  .paths .container {
    display: grid;
    gap: var(--s-section);
  }
  .path {
    display: grid;
    gap: var(--s-6);
  }
  .path__media {
    display: block;
  }
  .path__text {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
    max-width: 28rem;
  }
  @media (min-width: 64rem) {
    .path {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: center;
    }
    .path__media {
      grid-column: 1 / span 7;
    }
    .path__text {
      grid-column: 9 / span 4;
    }
    .path--flip .path__media {
      grid-column: 6 / span 7;
      order: 2;
    }
    .path--flip .path__text {
      grid-column: 1 / span 4;
      order: 1;
    }
  }
</style>
