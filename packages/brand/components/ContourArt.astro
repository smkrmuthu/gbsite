---
/**
 * Layered ridgeline drawing: a deterministic, clearly illustrative stand-in
 * used wherever an estate photograph has not been supplied yet. It is NOT a
 * depiction of the estate and is always decorative (aria-hidden).
 */
interface Props {
  seed: string;
  tone?: 'forest' | 'espresso' | 'beige' | 'cream' | 'olive';
  lines?: number;
  class?: string;
}
const { seed, tone = 'forest', lines = 12, class: className } = Astro.props;

const palettes = {
  forest: { bg: '#183c32', line: '#a9ad8f' },
  espresso: { bg: '#30231d', line: '#b9a88c' },
  beige: { bg: '#d9c9ae', line: '#5c6146' },
  cream: { bg: '#ece5d6', line: '#858b69' },
  olive: { bg: '#5c6146', line: '#d9c9ae' },
};
const { bg, line } = palettes[tone];

// Small seeded PRNG so each slot always draws the same hills.
let h = 1779033703 ^ seed.length;
for (let i = 0; i < seed.length; i++) {
  h = Math.imul(h ^ seed.charCodeAt(i), 3432918353);
  h = (h << 13) | (h >>> 19);
}
let s = h >>> 0;
const rand = () => {
  s |= 0;
  s = (s + 0x6d2b79f5) | 0;
  let t = Math.imul(s ^ (s >>> 15), 1 | s);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

const W = 1200;
const H = 800;
const step = 8;
const ridges: { d: string; opacity: number }[] = [];
for (let i = 0; i < lines; i++) {
  const t = i / (lines - 1);
  // Back ridges sit high and are tall; front ridges sit low and are gentler.
  const baseY = H * (0.34 + t * 0.78);
  const peaks = Array.from({ length: 1 + Math.floor(rand() * 2.2) }, () => ({
    x: W * (-0.1 + rand() * 1.2),
    w: W * (0.14 + rand() * 0.3),
    h: H * (0.12 + rand() * 0.22) * (1 - t * 0.5),
  }));
  const waves = Array.from({ length: 2 }, () => ({
    f: ((3 + rand() * 6) * Math.PI * 2) / W,
    p: rand() * Math.PI * 2,
  }));
  let d = '';
  for (let x = -step; x <= W + step; x += step) {
    const lift = peaks.reduce((sum, pk) => sum + pk.h * Math.exp(-(((x - pk.x) / pk.w) ** 2)), 0);
    const texture = waves.reduce((sum, w) => sum + Math.sin(w.f * x + w.p), 0) * H * 0.006;
    const y = baseY - lift - texture;
    d += `${x === -step ? 'M' : 'L'}${x},${y.toFixed(1)}`;
  }
  d += `L${W + step},${H + step}L${-step},${H + step}Z`;
  ridges.push({ d, opacity: 0.35 + t * 0.65 });
}
---

<svg
  class:list={['contour-art', className]}
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
  style={`background:${bg}`}
>
  {
    ridges.map((r) => (
      <path d={r.d} fill={bg} stroke={line} stroke-opacity={r.opacity} stroke-width="1.25" vector-effect="non-scaling-stroke" />
    ))
  }
</svg>

<style>
  .contour-art {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
