---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/PageHero.astro';
import BuyCoffee from '../components/BuyCoffee.astro';
import Photo from '@glazebrooke/brand/components/Photo.astro';
import Draft from '@glazebrooke/brand/components/Draft.astro';
---

<MainLayout
  title="Our People: The Team Behind the Coffee | Glazebrooke Coffee Estate"
  description="Meet the people of Glazebrooke Coffee Estate in Yercaud, whose care and craft through the year make every harvest possible."
>
  <PageHero
    title="Coffee is grown by people."
    lede="Every season at Glazebrooke depends on the people who work the estate: planting, tending, harvesting and caring for the coffee through the year."
    photo="sorting-cherries"
    tone="beige"
  />

  <section class="section surface-paper" aria-labelledby="craft-title">
    <div class="container grid">
      <div class="craft__text prose">
        <h2 id="craft-title" class="t-2xl">Craft and care</h2>
        <p>
          Much of the work on a coffee estate is done by hand, and much of the knowledge behind it is passed on in person, season after
          season.
        </p>
        <p>These are the people who make Glazebrooke coffee what it is. We want to introduce them properly, in their own words.</p>
      </div>
      <div class="craft__media">
        <Photo slot="coffee-crates" tone="espresso" ratio="5 / 4" sizes="(min-width: 64rem) 50vw, 100vw" />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="team-title">
    <div class="container grid">
      <div class="team__media">
        <Photo slot="people-portrait" tone="olive" ratio="3 / 4" sizes="(min-width: 64rem) 35vw, 100vw" />
      </div>
      <div class="team__text prose">
        <h2 id="team-title" class="t-2xl">The team</h2>
        <Draft>
          <p>
            Many of the people who work at Glazebrooke bring years of experience with coffee and with these hills. Their skill shows in every
            stage of the work, from tending the plants to bringing in the harvest.
          </p>
          <p>In the coming months we will introduce some of them here, in their own words.</p>
        </Draft>
      </div>
    </div>
  </section>

  <BuyCoffee />
</MainLayout>

<style>
  .craft__text,
  .team__text {
    align-self: center;
  }
  .craft__text > * + *,
  .team__text > * + * {
    margin-top: var(--s-5);
  }
  @media (min-width: 64rem) {
    .craft__text {
      grid-column: 1 / span 5;
    }
    .craft__media {
      grid-column: 7 / -1;
    }
    .team__media {
      grid-column: 2 / span 4;
    }
    .team__text {
      grid-column: 7 / span 5;
    }
  }
</style>
