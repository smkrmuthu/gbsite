# Copy to apps/main/.env and/or apps/shop/.env (or set in your host's dashboard).
# All values are optional; defaults shown.

# Production domains: used for canonical URLs, sitemaps, robots.txt and cross-links.
PUBLIC_MAIN_SITE_URL=https://glazebrookecoffee.com
PUBLIC_SHOP_URL=https://shop.glazebrookecoffee.com

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Empty = no analytics code at all.
# Use a separate ID per site, or the same one with both domains in one GA4 property.
PUBLIC_GA4_ID=

# Google Search Console HTML-tag verification token (only the content="..." value).
PUBLIC_GSC_VERIFICATION=

# true = hide "To be supplied by the estate" notes and photo-placeholder captions.
PUBLIC_HIDE_PLACEHOLDERS=false

# false = remove owner-supplied but unverified facts (1950s, 70+ years,
# family-owned, 3,400–4,200 ft) from all copy. See packages/brand/config/facts.ts.
PUBLIC_PUBLISH_UNVERIFIED_FACTS=true
