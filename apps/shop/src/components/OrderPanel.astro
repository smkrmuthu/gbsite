---
/**
 * The ordering call to action for one product. Says plainly what happens on
 * click. Placeholder products show a note; with no ordering route configured
 * the button leads to the contact page instead.
 */
import { orderAction } from '@glazebrooke/brand/lib/links';
import { type Product, isPublished } from '../data/products';

interface Props {
  product: Product;
}
const { product } = Astro.props;
const pageUrl = new URL(`/products/${product.slug}/`, Astro.site).href;
const action = product.orderUrl
  ? { href: product.orderUrl, label: 'Order online', explains: 'Takes you to the ordering page for this coffee.', newTab: false }
  : orderAction(product.name, pageUrl);
---

<div class="order">
  {
    !isPublished(product) ? (
      <p class="order__note">Ordering opens once this product's details are confirmed.</p>
    ) : action ? (
      <>
        <a
          class="btn order__btn"
          href={action.href}
          data-track="order_click"
          data-track-label={product.name}
          {...(action.newTab ? { target: '_blank', rel: 'noopener' } : {})}
        >
          {action.label}
          {action.newTab && <span class="visually-hidden"> (opens in a new tab)</span>}
        </a>
        <p class="order__explains">{action.explains}</p>
      </>
    ) : (
      <>
        <a class="btn order__btn" href="/contact/" data-track="order_click" data-track-label={`${product.name} (contact)`}>
          Contact us to order
        </a>
        <p class="order__explains">Online ordering is being set up. Send us a message and we will help you place your order.</p>
      </>
    )
  }
</div>

<style>
  .order {
    display: grid;
    gap: var(--s-3);
    justify-items: start;
  }
  .order__btn {
    min-width: 14rem;
  }
  .order__explains,
  .order__note {
    font-size: var(--t-sm);
    color: var(--c-text-muted);
    max-width: 26rem;
  }
</style>
