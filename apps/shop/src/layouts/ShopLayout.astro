---
import SiteLayout from '@glazebrooke/brand/components/SiteLayout.astro';
import { graph, webPageSchema, websiteSchema, organizationSchema } from '@glazebrooke/brand/lib/seo';
import { SITE_NAME, DESCRIPTOR, nav, estateCta, footerNav, crossLink } from '../site';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'product';
  noindex?: boolean;
  schema?: Record<string, unknown>[];
}
const { title, description, image, imageAlt, ogType, noindex, schema = [] } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
const isHome = Astro.url.pathname === '/';

const jsonLd = noindex
  ? undefined
  : graph(
      ...(isHome ? [organizationSchema(), websiteSchema('shop')] : []),
      webPageSchema({ url, name: title, description, site: 'shop' }),
      ...schema,
    );
---

<SiteLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  ogType={ogType}
  noindex={noindex}
  jsonLd={jsonLd}
  siteName={SITE_NAME}
  descriptor={DESCRIPTOR}
  nav={nav}
  cta={estateCta}
  footerNav={footerNav}
  crossLink={crossLink}
>
  <slot />
</SiteLayout>
