---
import MainLayout from '../layouts/MainLayout.astro';
import ContactDetails from '@glazebrooke/brand/components/ContactDetails.astro';
import ContactForm from '@glazebrooke/brand/components/ContactForm.astro';
import { shopUrl } from '@glazebrooke/brand/lib/links';
---

<MainLayout
  title="Contact Glazebrooke Coffee Estate, Yercaud | Enquiries and Partnerships"
  description="Contact Glazebrooke Coffee Estate in Yercaud, Tamil Nadu, with questions about the estate, our coffee, trade or partnerships."
>
  <section class="section contact">
    <div class="container grid">
      <div class="contact__intro">
        <h1>Get in touch.</h1>
        <p class="contact__lede">
          Questions about the estate, our coffee, or working together on trade and partnerships: we would be glad to hear from you.
        </p>
        <ContactDetails />
        <div class="contact__shop">
          <h2 class="t-2xl">Buying coffee?</h2>
          <p>Our shop lists the current range and explains how to order.</p>
          <a class="text-link" href={shopUrl('/')} data-track="shop_click" data-track-label="contact page">Visit the shop</a>
        </div>
      </div>
      <div class="contact__form">
        <h2 class="t-2xl">Send us a message</h2>
        <ContactForm topics={['General enquiry', 'Buying coffee', 'Trade and partnerships', 'Press and media']} />
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .contact {
    padding-top: var(--s-9);
  }
  .contact__intro {
    display: grid;
    gap: var(--s-7);
    align-content: start;
  }
  .contact__lede {
    max-width: 30rem;
    font-size: var(--t-lg);
    margin-top: calc(var(--s-7) * -0.5);
  }
  .contact__shop {
    display: grid;
    gap: var(--s-3);
    justify-items: start;
  }
  .contact__form {
    display: grid;
    gap: var(--s-6);
    align-content: start;
  }
  @media (min-width: 64rem) {
    .contact__intro {
      grid-column: 1 / span 6;
    }
    .contact__form {
      grid-column: 8 / -1;
      padding: var(--s-7);
      background: var(--c-paper);
      border: 1px solid var(--c-rule);
    }
  }
</style>
