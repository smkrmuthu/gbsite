{
  "name": "glazebrooke-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "node-html-parser": "^9.0.7",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "dev:main": "npm run dev -w @glazebrooke/main",
    "dev:shop": "npm run dev -w @glazebrooke/shop",
    "build": "npm run build:main && npm run build:shop",
    "build:main": "npm run build -w @glazebrooke/main",
    "build:shop": "npm run build -w @glazebrooke/shop",
    "preview:main": "npm run preview -w @glazebrooke/main",
    "preview:shop": "npm run preview -w @glazebrooke/shop",
    "check": "npm run check -w @glazebrooke/main && npm run check -w @glazebrooke/shop",
    "verify": "node scripts/verify-sites.mjs",
    "ci": "npm run check && npm run build && npm run verify",
    "content:status": "node scripts/content-status.mjs",
    "import:legacy": "node scripts/import-legacy-site.mjs",
    "assets:brand": "node scripts/generate-brand-assets.mjs"
  }
}
